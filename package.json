{
  "name": "videoclaw-remote",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "description": "CLI + MCP server that drives Videoclaw chat sessions over the app's DevTools port",
  "bin": {
    "vc": "dist/vc.mjs",
    "videoclaw-mcp": "dist/mcp.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.20.0",
    "zod": "^3.25.0"
  },
  "scripts": {
    "build": "esbuild src/mcp.mjs bin/vc.mjs --bundle --platform=node --format=esm --target=node22 --outdir=dist '--entry-names=[name]' --out-extension:.js=.mjs \"--banner:js=import{createRequire as __cr}from'module';const require=__cr(import.meta.url);\""
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  },
  "license": "MIT"
}
